# Managed by Ansible (moodle.yml) — reverse proxy for {{ moodle_domain }}
# in front of the Moodle webserver container on 127.0.0.1:{{ moodle_web_port }}.

server {
    listen 80;
    server_name {{ moodle_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ moodle_domain }};

    ssl_certificate     /etc/nginx/certs/moodle/cert.pem;
    ssl_certificate_key /etc/nginx/certs/moodle/key.pem;

    ssl_protocols   TLSv1.2 TLSv1.3;
    ssl_ciphers     HIGH:!aNULL:!MD5;

    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:{{ moodle_web_port }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
